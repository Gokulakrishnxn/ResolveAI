{
  "name": "@resolveai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/websocket": "^10.0.1",
    "@resolveai/ai": "workspace:*",
    "ws": "^8.17.1",
    "@resolveai/db": "workspace:*",
    "@resolveai/integrations-chat": "workspace:*",
    "@resolveai/integrations-email": "workspace:*",
    "@resolveai/integrations-shopify": "workspace:*",
    "@resolveai/integrations-stripe": "workspace:*",
    "@resolveai/integrations-whatsapp": "workspace:*",
    "@resolveai/integrations-woocommerce": "workspace:*",
    "@resolveai/shared": "workspace:*",
    "bullmq": "^5.8.7",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "ioredis": "^5.4.1",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2"
  }
}
