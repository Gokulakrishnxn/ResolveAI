{
  "name": "@resolveai/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@resolveai/ai": "workspace:*",
    "@resolveai/db": "workspace:*",
    "@resolveai/integrations-email": "workspace:*",
    "@resolveai/integrations-shopify": "workspace:*",
    "@resolveai/integrations-stripe": "workspace:*",
    "@resolveai/integrations-whatsapp": "workspace:*",
    "@resolveai/integrations-woocommerce": "workspace:*",
    "@resolveai/shared": "workspace:*",
    "bullmq": "^5.8.7",
    "ioredis": "^5.4.1",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2"
  }
}
