{
  "name": "resolveai",
  "version": "0.1.0",
  "private": true,
  "description": "ResolveAI — AI Customer Support Auto-Resolver for Shopify/WooCommerce",
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @resolveai/db generate",
    "db:migrate": "pnpm --filter @resolveai/db migrate",
    "db:push": "pnpm --filter @resolveai/db push",
    "db:studio": "pnpm --filter @resolveai/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "turbo": "^2.0.6",
    "typescript": "^5.5.3"
  }
}
