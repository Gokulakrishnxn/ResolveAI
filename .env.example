###############################################
# ResolveAI – Environment Variables
# Copy to `.env` and fill in real values.
###############################################

# --- Runtime ----------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Web (Next.js) ----------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Demo identifiers used by the dashboard when Clerk is not yet wired up.
# Run `pnpm db:seed`; the seed script prints the IDs to use here.
NEXT_PUBLIC_DEMO_STORE_ID=
NEXT_PUBLIC_DEMO_USER_ID=

# --- API (Fastify) ----------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
API_BODY_LIMIT=1048576
API_INTERNAL_TOKEN=change-me-internal-token

# --- Database (Postgres + pgvector) -----------
DATABASE_URL=postgresql://resolveai:resolveai@localhost:5432/resolveai?schema=public
DIRECT_URL=postgresql://resolveai:resolveai@localhost:5432/resolveai?schema=public

# --- Redis (BullMQ) ---------------------------
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_PREFIX=resolveai

# --- Auth (Clerk) -----------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# --- OpenAI -----------------------------------
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL_CLASSIFIER=gpt-4o-mini
OPENAI_MODEL_RESOLVER=gpt-4o
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_TIMEOUT_MS=30000

# --- Shopify ----------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:4000
SHOPIFY_SCOPES=read_orders,write_orders,read_customers,read_products
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2024-07

# --- Encryption -------------------------------
# Base64-encoded 32-byte key used to wrap integration credentials at rest.
# Generate locally with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Phase 1 feature flags --------------------
AUTO_RESOLVE_ORDER_STATUS=true
AUTO_APPROVE_REFUNDS=false

# --- WooCommerce ------------------------------
WOOCOMMERCE_DEFAULT_VERSION=wc/v3

# --- Email (IMAP + SMTP) ----------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="ResolveAI <support@example.com>"

IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=

# --- Chat widget / WebSocket ------------------
CHAT_WS_PORT=4001
CHAT_WIDGET_PUBLIC_KEY=public_key_xxx

# --- Observability ----------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
